# Copy to .env and fill in. Never commit .env.
# Data: Zetaris (local install)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Sample mode: true = no key, no network, every agent on its rules (marked degraded)
SAMPLE_MODE=false
# Power: where model calls start (meterless | nvidia | rules); each falls back to the next
MODEL_PROVIDER=meterless
# Meterless Runtime (Nightshift Console): URL and token. Pinned routing modes, never meterless/auto
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL_FAST=meterless/fast
METERLESS_MODEL_DEEP=meterless/deep
# NVIDIA direct (build.nvidia.com): the fallback, and the route smoke_test.py checks
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NEMOTRON_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_MODEL_DEEP=nvidia/nemotron-3.5-super-vl-120b-a12b
